# BIRDE - environment configuration
# Copy to .env and fill in your values.

# Admin panel password. REQUIRED - without it the admin panel is disabled.
ADMIN_TOKEN=

# Instagram webhook verify token (optional, leave empty to disable the webhook).
INSTAGRAM_VERIFY_TOKEN=

# Where the JSON database file is stored. On Render, point this to the mounted disk.
DATA_DIR=./server/data

# AI chatbot + Dizaýn studia (AI logo/wizitka generasiýa).
# When these are set, the chat uses the LLM and the design studio tries AI
# SVG generation; otherwise the offline rule-based bot / template designs are used.
# To use Google Gemini (free tier): get a key at https://aistudio.google.com/
#   USER_LLM_API_KEY=<gemini api key>
#   USER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   USER_LLM_MODEL=gemini-flash-latest
# Or any OpenAI-compatible provider, e.g. DeepSeek:
#   USER_LLM_API_KEY=
#   USER_LLM_BASE_URL=https://api.deepseek.com/v1
#   USER_LLM_MODEL=deepseek-chat
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# Dizaýn studia üçin Cloudflare Workers AI (FLUX.1 Schnell) surat generasiýa.
# Açar: Cloudflare Dashboard → My Profile → API Tokens
# Account ID: Cloudflare Dashboard → right side "Account ID"
# Köp açar goýmak üçin (kwota gutarandan soň awtomatik beýlekä geçýär):
#   1-nji: CF_API_TOKEN + CF_ACCOUNT_ID (ýa-da CF_API_TOKEN_1/CF_ACCOUNT_ID_1)
#   2-nji: CF_API_TOKEN_2 + CF_ACCOUNT_ID_2
#   3-nji: CF_API_TOKEN_3 + CF_ACCOUNT_ID_3  (4...10 çenli mümkin)
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_API_TOKEN_2=
CF_ACCOUNT_ID_2=
CF_API_TOKEN_3=
CF_ACCOUNT_ID_3=
